# Keep this relative when the frontend is served behind the same origin/reverse proxy as FastAPI.
VITE_API_BASE_URL=/api/v1

# Development only: Vite proxies /api requests here, avoiding a browser CORS dependency.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Optional. Leave empty to let FastAPI dev auth use its configured defaults.
VITE_DEV_USER=
VITE_DEV_TENANT=

# Optional OIDC bearer token for a non-dev backend. Prefer a real OIDC integration before production.
VITE_BEARER_TOKEN=
