ENVIRONMENT=development
AUTH_MODE=dev

# PostgreSQL is the primary local/dev database.
DATABASE_URL=postgresql+psycopg://athleteops:athleteops@localhost:5432/athleteops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Intent provider options: rule_based | openrouter | groq | auto
# auto tries OpenRouter first, then Groq, then deterministic rules when enabled.
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_FALLBACK_TO_RULES=true

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=APEX AthleteOps

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

LANGGRAPH_CHECKPOINT_DB=./langgraph_checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true

# ML baseline / experiment tracking.
ML_ARTIFACT_DIR=./artifacts/ml
ML_EXPERIMENT_NAME=athlete-recovery-intervention-baseline
ML_MODEL_NAME=athlete-recovery-intervention
ML_DATASET_NAME=synthetic-athlete-recovery-v1
ML_FEATURE_SCHEMA_VERSION=recovery-features:v1
ML_RANDOM_SEED=42
ML_MIN_AUC_LIFT=0.02
